#!/usr/bin/env python3
"""Fake prime-agent: replays a pinned event fixture and records its argv.

Self-contained on purpose. The runner sanitizes the child environment down to
an allowlist, so this script must not depend on ambient variables to find its
fixture: it resolves both the fixture and its failure mode relative to its own
location.
"""
import json, os, pathlib, sys

here = pathlib.Path(__file__).resolve().parent
fixture = here.parent / "host-events" / "prime.jsonl"

log = os.environ.get("FAKE_HOST_ARGV_LOG")
if log:
    with open(log, "a", encoding="utf-8") as handle:
        handle.write(json.dumps({"argv": sys.argv, "cwd": os.getcwd()}) + "\n")

mode_file = here / "MODE"
mode = os.environ.get("FAKE_HOST_MODE") or (
    mode_file.read_text(encoding="utf-8").strip() if mode_file.exists() else "ok"
)

if mode == "nonzero":
    sys.stderr.write("fake failure\n")
    raise SystemExit(3)
if mode == "garbage":
    sys.stdout.write("not json at all\n")
    raise SystemExit(0)
if mode == "hang":
    import time
    time.sleep(600)

sys.stdout.write(fixture.read_text(encoding="utf-8"))
