{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koroche-blyat.invalid/schemas/golden.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goldens"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "goldens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/golden"
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "regex",
        "critical"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "regex": {
          "type": [
            "string",
            "null"
          ]
        },
        "critical": {
          "type": "boolean"
        }
      }
    },
    "protected_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrences"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "utf8_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-fA-F]{2})+$"
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "text"
          ],
          "not": {
            "required": [
              "utf8_hex"
            ]
          }
        },
        {
          "required": [
            "utf8_hex"
          ],
          "not": {
            "required": [
              "text"
            ]
          }
        }
      ]
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_ids"
      ],
      "properties": {
        "fact_ids": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_units",
        "max_units"
      ],
      "properties": {
        "min_units": {
          "type": "integer",
          "minimum": 1
        },
        "max_units": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_cyrillic_ratio"
      ],
      "properties": {
        "min_cyrillic_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "banned_patterns"
      ],
      "properties": {
        "banned_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_profanity",
        "targeted_abuse",
        "destructive_warning_joke"
      ],
      "properties": {
        "public_profanity": {
          "type": "boolean"
        },
        "targeted_abuse": {
          "type": "boolean"
        },
        "destructive_warning_joke": {
          "type": "boolean"
        }
      }
    },
    "golden": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "facts",
        "protected_spans",
        "orders",
        "shape",
        "language",
        "style",
        "boundary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "protected_spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/protected_span"
          }
        },
        "orders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/order"
          }
        },
        "shape": {
          "anyOf": [
            {
              "$ref": "#/$defs/shape"
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/language"
            },
            {
              "type": "null"
            }
          ]
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/$defs/style"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundary": {
          "$ref": "#/$defs/boundary"
        }
      }
    }
  }
}
