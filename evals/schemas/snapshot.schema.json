{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koroche-blyat.invalid/schemas/snapshot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshots"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "snapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/snapshot"
      }
    },
    "expected": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "arm",
        "case_id",
        "repetition",
        "turn",
        "text",
        "golden_id",
        "infrastructure_error"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "arm": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "repetition": {
          "type": "integer",
          "minimum": 1
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        },
        "golden_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "infrastructure_error": {
          "type": "boolean"
        },
        "host_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "response_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "stdout_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "stderr_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "runner_git_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "schema_version": {
          "const": 1
        },
        "grader_version": {
          "const": 1
        }
      }
    }
  }
}
