{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koroche-blyat.invalid/schemas/grade.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "expected",
    "graded",
    "passed",
    "failed",
    "blocked",
    "infrastructure_errors",
    "fact_passed",
    "fact_total",
    "simple_shape_passed",
    "simple_shape_total",
    "grades",
    "release_ok"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "expected": {
      "type": "integer",
      "minimum": 0
    },
    "graded": {
      "type": "integer",
      "minimum": 0
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "blocked": {
      "type": "integer",
      "minimum": 0
    },
    "infrastructure_errors": {
      "type": "integer",
      "minimum": 0
    },
    "fact_passed": {
      "type": "integer",
      "minimum": 0
    },
    "fact_total": {
      "type": "integer",
      "minimum": 0
    },
    "simple_shape_passed": {
      "type": "integer",
      "minimum": 0
    },
    "simple_shape_total": {
      "type": "integer",
      "minimum": 0
    },
    "grades": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/grade"
      }
    },
    "release_ok": {
      "type": "boolean"
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "passed",
        "required",
        "detail"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "grade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "arm",
        "case_id",
        "repetition",
        "turn",
        "golden_id",
        "assertions",
        "passed",
        "blocked",
        "block_reasons",
        "fact_passed",
        "fact_total",
        "protected_passed",
        "protected_total",
        "order_passed",
        "order_total",
        "shape_passed",
        "language_passed",
        "style_passed",
        "boundary_passed",
        "infrastructure_error"
      ],
      "properties": {
        "host": {
          "type": "string"
        },
        "arm": {
          "type": "string"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "repetition": {
          "type": "integer",
          "minimum": 1
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "golden_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "passed": {
          "type": "boolean"
        },
        "blocked": {
          "type": "boolean"
        },
        "block_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fact_passed": {
          "type": "integer",
          "minimum": 0
        },
        "fact_total": {
          "type": "integer",
          "minimum": 0
        },
        "protected_passed": {
          "type": "integer",
          "minimum": 0
        },
        "protected_total": {
          "type": "integer",
          "minimum": 0
        },
        "order_passed": {
          "type": "integer",
          "minimum": 0
        },
        "order_total": {
          "type": "integer",
          "minimum": 0
        },
        "shape_passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "language_passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "style_passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "boundary_passed": {
          "type": "boolean"
        },
        "infrastructure_error": {
          "type": "boolean"
        }
      }
    }
  }
}
